{
  "name": "static-website-template",
  "version": "1.0.0",
  "description": "Static website template based on HTML, CSS & JavaScript - with live browser updates.",
  "main": "index.js",
  "scripts": {
    "serve": "live-server dist --port=3000",
    "serve-vsc": "live-server dist --port=3000 --no-browser",
    "watch": "onchange \"src/**/*\" -- npm run build",
    "build": "copyfiles -u 1 \"src/**/*\" dist",
    "dev": "run-p serve watch",
    "dev-vsc": "run-p serve-vsc watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolf81/static-website-template.git"
  },
  "author": "Wolfgang Schreurs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wolf81/static-website-template/issues"
  },
  "homepage": "https://github.com/wolf81/static-website-template#readme",
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0"
  }
}
