{
  "name": "genesis",
  "version": "1.0.0",
  "description": "World generation tools",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "browser-sync start --config bs-config.js",
    "watch:css": "onchange \"src/style/**/*.css\" -- npm run build:css",
    "build:css": "copyfiles -u 1 \"src/style/**/*.css\" dist",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "watch:html": "onchange \"src/**/*.html\" -- npm run build:html",
    "build:html": "copyfiles -u 1 \"src/**/*.html\" dist",
    "watch": "npm run build && run-p serve watch:*",
    "build": "run-p build:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolf81/genesis.git"
  },
  "author": "Wolfgang Schreurs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wolf81/genesis/issues"
  },
  "homepage": "https://github.com/wolf81/genesis#readme",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "copyfiles": "^2.4.1",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "typescript": "^5.8.3"
  }
}
