{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve",
            "command": "npm",
            "type": "shell",
            "args": ["run", "serve-vsc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "close": true,
                "revealProblems": "onProblem",
            },
            "isBackground": true,
            "problemMatcher": [],
            "auto": true, // relies on AutoLaunch extension
        },
        {
            "label": "Monitor TypeScript errors",
            "command": "npm",
            "type": "shell",
            "args": ["run", "watch-vsc"],
            "presentation": {
                "echo": true,
                "reveal": "never",
                "focus": false,
                "panel": "shared",
                "close": true,
                "revealProblems": "onProblem",
            },
            "isBackground": true,
            "problemMatcher": "$tsc-watch",
            "auto": true, // relies on AutoLaunch extension
        }
    ]
} 
